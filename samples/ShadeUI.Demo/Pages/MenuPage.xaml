<UserControl
    x:Class="ShadeUI.Demo.Pages.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.shadeui.dev/2026/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ContextMenu ve ToolTip" />
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Menüler ve ipuçları, ComboBox açılır listesiyle aynı flyout yüzeyini kullanır. TextBox'ların yerleşik Kes/Kopyala/Yapıştır menüsü de bu stille çizilir." />

            <ui:ControlExample x:Name="Ex1" Description="Düğmeye sağ tıkla. Kısayol metni, onay işareti, ayırıcı ve iç içe alt menü desteklenir." Header="Bağlam menüsü">
                <Button Content="Sağ tıkla">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kes" InputGestureText="Ctrl+X" />
                            <MenuItem Header="Kopyala" InputGestureText="Ctrl+C" />
                            <MenuItem Header="Yapıştır" InputGestureText="Ctrl+V" />
                            <Separator />
                            <MenuItem
                                Header="Sabitlenmiş"
                                IsCheckable="True"
                                IsChecked="True" />
                            <MenuItem Header="Devre dışı" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="Daha fazla">
                                <MenuItem Header="Dışa aktar" />
                                <MenuItem Header="İçe aktar" />
                                <MenuItem Header="Farklı kaydet">
                                    <MenuItem Header="PNG" />
                                    <MenuItem Header="SVG" />
                                </MenuItem>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </ui:ControlExample>

            <ui:ControlExample x:Name="Ex2" Description="Menü çubuğu için Menu; üst seviye öğeler aşağı açılır." Header="Menü çubuğu">
                <Menu HorizontalAlignment="Left">
                    <MenuItem Header="_Dosya">
                        <MenuItem Header="Yeni" InputGestureText="Ctrl+N" />
                        <MenuItem Header="Aç" InputGestureText="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="Çıkış" />
                    </MenuItem>
                    <MenuItem Header="_Düzen">
                        <MenuItem Header="Geri al" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="Yinele" InputGestureText="Ctrl+Y" />
                    </MenuItem>
                    <MenuItem Header="_Görünüm">
                        <MenuItem
                            Header="Durum çubuğu"
                            IsCheckable="True"
                            IsChecked="True" />
                    </MenuItem>
                </Menu>
            </ui:ControlExample>

            <ui:ControlExample x:Name="Ex3" Description="Herhangi bir kontrole ToolTip verilebilir; uzun metin MaxWidth'e göre sarar." Header="ToolTip">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Üzerine gel" ToolTip="ToolTip de aynı flyout yüzeyini kullanıyor." />
                    <ui:TextBox
                        Width="200"
                        Margin="10,0,0,0"
                        PlaceholderText="Buraya da ipucu var"
                        ToolTip="Uzun bir ipucu metni, kutunun genişliğini aşınca kendiliğinden satır kırar ve okunur kalır." />
                </StackPanel>
            </ui:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ShadeUI.Demo.Pages.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tema" />
            <TextBlock
                x:Name="CurrentThemeText"
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />

            <Border Margin="0,16,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tema modu" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Click="OnLightClick" Content="Açık" />
                        <Button
                            Margin="8,0,0,0"
                            Click="OnDarkClick"
                            Content="Koyu" />
                        <Button
                            Margin="8,0,0,0"
                            Click="OnSystemClick"
                            Content="Sistemi Takip Et"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Vurgu (accent) rengi" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" />
                            <Border
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                CornerRadius="4" />
                            <Border
                                Width="32"
                                Height="32"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Windows vurgu renginden türetilen Default / Secondary / Tertiary dolgular." />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Yüzey rampası" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Kabuk, içerik paneli, kart ve kontrol tek bir düzgün gri rampada; her basamak bir öncekinden altı ton açık." />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Border
                            Width="64"
                            Height="40"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border
                            Width="64"
                            Height="40"
                            Margin="6,0,0,0"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border
                            Width="64"
                            Height="40"
                            Margin="6,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border
                            Width="64"
                            Height="40"
                            Margin="6,0,0,0"
                            Background="{DynamicResource FlyoutBackgroundBrush}"
                            BorderBrush="{DynamicResource FlyoutBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Kabuk · Panel · Kart · Flyout" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tipografi rampası" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Title — 20" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Subtitle — 16" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Body Strong — 12" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Body — 12" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Caption — 11" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ShadeUI.Demo.Pages.ThemePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tema" />
            <TextBlock
                x:Name="CurrentThemeText"
                Margin="0,8,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />

            <Border Margin="0,24,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tema modu" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Click="OnLightClick" Content="Açık" />
                        <Button
                            Margin="12,0,0,0"
                            Click="OnDarkClick"
                            Content="Koyu" />
                        <Button
                            Margin="12,0,0,0"
                            Click="OnSystemClick"
                            Content="Sistemi Takip Et"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Vurgu (accent) rengi" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border
                                Width="40"
                                Height="40"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" />
                            <Border
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                CornerRadius="4" />
                            <Border
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                CornerRadius="4" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Windows vurgu renginden türetilen Default / Secondary / Tertiary dolgular." />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

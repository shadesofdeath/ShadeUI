<UserControl
    x:Class="ShadeUI.Demo.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.shadeui.dev/2026/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Kontroller" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Button, TextBox, CheckBox, RadioButton, ToggleSwitch ve ComboBox hazır. NavigationView sıradaki adımda geliyor." />

            <Border Margin="0,16,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Button" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Varsayılan" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Vurgulu"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Devre Dışı"
                            IsEnabled="False" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Vurgulu Devre Dışı"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="TextBox" />

                    <WrapPanel Margin="0,8,0,0" ItemHeight="54">
                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Placeholder" />
                            <ui:TextBox PlaceholderText="Adınızı yazın" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Soldan ikonlu" />
                            <ui:TextBox Icon="&#xE721;" PlaceholderText="Ara" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Sağdan ikonlu + dolu" />
                            <ui:TextBox
                                Icon="&#xE715;"
                                IconPlacement="Right"
                                Text="ornek@shadeui.dev" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Salt okunur" />
                            <ui:TextBox IsReadOnly="True" Text="Değiştirilemez" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Devre dışı" />
                            <ui:TextBox
                                IsEnabled="False"
                                PlaceholderText="Devre dışı"
                                Text="Devre dışı" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Düz WPF TextBox" />
                            <TextBox Text="Stil otomatik uygulanır" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock
                        Margin="0,4,0,4"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Çok satırlı" />
                    <ui:TextBox
                        Width="472"
                        Height="76"
                        HorizontalAlignment="Left"
                        AcceptsReturn="True"
                        ClearButtonEnabled="False"
                        PlaceholderText="Notlarınızı buraya yazabilirsiniz..."
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="CheckBox" />
                        <CheckBox
                            Margin="0,8,0,0"
                            Content="İşaretsiz"
                            IsChecked="False" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="İşaretli"
                            IsChecked="True" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Belirsiz (indeterminate)"
                            IsChecked="{x:Null}"
                            IsThreeState="True" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Devre dışı"
                            IsEnabled="False" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Devre dışı, işaretli"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="RadioButton" />
                        <RadioButton
                            Margin="0,8,0,0"
                            Content="Sistemi takip et"
                            GroupName="Demo"
                            IsChecked="True" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Her zaman açık"
                            GroupName="Demo" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Her zaman koyu"
                            GroupName="Demo" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Devre dışı"
                            GroupName="Demo2"
                            IsEnabled="False" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Devre dışı, seçili"
                            GroupName="Demo2"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ToggleSwitch" />
                        <ui:ToggleSwitch Margin="0,8,0,0" Content="Bildirimler" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            Content="Otomatik güncelleme"
                            IsChecked="True" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            Content="Devre dışı"
                            IsEnabled="False" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            Content="Devre dışı, açık"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Duruma göre etiket" />
                        <ui:ToggleSwitch
                            Margin="0,8,0,0"
                            IsChecked="True"
                            OffContent="Kapalı"
                            OnContent="Açık" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            OffContent="Wi-Fi kapalı"
                            OnContent="Wi-Fi açık" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="OnContent / OffContent verilirse etiket duruma göre değişir; verilmezse Content kullanılır."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ComboBox" />

                    <WrapPanel Margin="0,8,0,0" ItemHeight="54">
                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Varsayılan" />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Sistemi takip et" />
                                <ComboBoxItem Content="Açık tema" />
                                <ComboBoxItem Content="Koyu tema" />
                                <ComboBoxItem Content="Yüksek kontrast" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Düzenlenebilir" />
                            <ComboBox IsEditable="True" Text="Segoe UI Variable">
                                <ComboBoxItem Content="Segoe UI Variable" />
                                <ComboBoxItem Content="Cascadia Code" />
                                <ComboBoxItem Content="Consolas" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Devre dışı" />
                            <ComboBox
                                IsEnabled="False"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Değiştirilemez" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ContextMenu / ToolTip" />

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Sağ tıkla" ToolTip="Bu düğmeye sağ tıklayınca temalı bağlam menüsü açılır.">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kes" InputGestureText="Ctrl+X" />
                                    <MenuItem Header="Kopyala" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="Yapıştır" InputGestureText="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="Sabitlenmiş" IsCheckable="True" IsChecked="True" />
                                    <MenuItem Header="Devre dışı" IsEnabled="False" />
                                    <Separator />
                                    <MenuItem Header="Daha fazla">
                                        <MenuItem Header="Dışa aktar" />
                                        <MenuItem Header="İçe aktar" />
                                        <MenuItem Header="Farklı kaydet">
                                            <MenuItem Header="PNG" />
                                            <MenuItem Header="SVG" />
                                        </MenuItem>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button
                            Margin="8,0,0,0"
                            Content="Üzerine gel"
                            ToolTip="ToolTip de aynı flyout yüzeyini kullanıyor."
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="TextBox'ların kendi Kes/Kopyala/Yapıştır menüsü de artık bu stili kullanıyor."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

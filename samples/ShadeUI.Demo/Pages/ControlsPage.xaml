<UserControl
    x:Class="ShadeUI.Demo.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.shadeui.dev/2026/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Kontroller" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Button, TextBox, CheckBox, RadioButton, ToggleSwitch ve ComboBox hazır. NavigationView sıradaki adımda geliyor." />

            <Border Margin="0,16,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Button" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Varsayılan" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Vurgulu"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Devre Dışı"
                            IsEnabled="False" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Vurgulu Devre Dışı"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="TextBox" />

                    <WrapPanel Margin="0,8,0,0" ItemHeight="54">
                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Placeholder" />
                            <ui:TextBox PlaceholderText="Adınızı yazın" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Soldan ikonlu" />
                            <ui:TextBox Icon="&#xE721;" PlaceholderText="Ara" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Sağdan ikonlu + dolu" />
                            <ui:TextBox
                                Icon="&#xE715;"
                                IconPlacement="Right"
                                Text="ornek@shadeui.dev" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Salt okunur" />
                            <ui:TextBox IsReadOnly="True" Text="Değiştirilemez" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Devre dışı" />
                            <ui:TextBox
                                IsEnabled="False"
                                PlaceholderText="Devre dışı"
                                Text="Devre dışı" />
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Düz WPF TextBox" />
                            <TextBox Text="Stil otomatik uygulanır" />
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock
                        Margin="0,4,0,4"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Çok satırlı" />
                    <ui:TextBox
                        Width="472"
                        Height="76"
                        HorizontalAlignment="Left"
                        AcceptsReturn="True"
                        ClearButtonEnabled="False"
                        PlaceholderText="Notlarınızı buraya yazabilirsiniz..."
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="CheckBox" />
                        <CheckBox
                            Margin="0,8,0,0"
                            Content="İşaretsiz"
                            IsChecked="False" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="İşaretli"
                            IsChecked="True" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Belirsiz (indeterminate)"
                            IsChecked="{x:Null}"
                            IsThreeState="True" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Devre dışı"
                            IsEnabled="False" />
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Devre dışı, işaretli"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="RadioButton" />
                        <RadioButton
                            Margin="0,8,0,0"
                            Content="Sistemi takip et"
                            GroupName="Demo"
                            IsChecked="True" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Her zaman açık"
                            GroupName="Demo" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Her zaman koyu"
                            GroupName="Demo" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Devre dışı"
                            GroupName="Demo2"
                            IsEnabled="False" />
                        <RadioButton
                            Margin="0,4,0,0"
                            Content="Devre dışı, seçili"
                            GroupName="Demo2"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ToggleSwitch" />
                        <ui:ToggleSwitch Margin="0,8,0,0" Content="Bildirimler" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            Content="Otomatik güncelleme"
                            IsChecked="True" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            Content="Devre dışı"
                            IsEnabled="False" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            Content="Devre dışı, açık"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Duruma göre etiket" />
                        <ui:ToggleSwitch
                            Margin="0,8,0,0"
                            IsChecked="True"
                            OffContent="Kapalı"
                            OnContent="Açık" />
                        <ui:ToggleSwitch
                            Margin="0,6,0,0"
                            OffContent="Wi-Fi kapalı"
                            OnContent="Wi-Fi açık" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="OnContent / OffContent verilirse etiket duruma göre değişir; verilmezse Content kullanılır."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ComboBox" />

                    <WrapPanel Margin="0,8,0,0" ItemHeight="54">
                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Varsayılan" />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Sistemi takip et" />
                                <ComboBoxItem Content="Açık tema" />
                                <ComboBoxItem Content="Koyu tema" />
                                <ComboBoxItem Content="Yüksek kontrast" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Düzenlenebilir" />
                            <ComboBox IsEditable="True" Text="Segoe UI Variable">
                                <ComboBoxItem Content="Segoe UI Variable" />
                                <ComboBoxItem Content="Cascadia Code" />
                                <ComboBoxItem Content="Consolas" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Devre dışı" />
                            <ComboBox
                                IsEnabled="False"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Değiştirilemez" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ContextMenu / ToolTip" />

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Sağ tıkla" ToolTip="Bu düğmeye sağ tıklayınca temalı bağlam menüsü açılır.">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kes" InputGestureText="Ctrl+X" />
                                    <MenuItem Header="Kopyala" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="Yapıştır" InputGestureText="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="Sabitlenmiş" IsCheckable="True" IsChecked="True" />
                                    <MenuItem Header="Devre dışı" IsEnabled="False" />
                                    <Separator />
                                    <MenuItem Header="Daha fazla">
                                        <MenuItem Header="Dışa aktar" />
                                        <MenuItem Header="İçe aktar" />
                                        <MenuItem Header="Farklı kaydet">
                                            <MenuItem Header="PNG" />
                                            <MenuItem Header="SVG" />
                                        </MenuItem>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button
                            Margin="8,0,0,0"
                            Content="Üzerine gel"
                            ToolTip="ToolTip de aynı flyout yüzeyini kullanıyor."
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="TextBox'ların kendi Kes/Kopyala/Yapıştır menüsü de artık bu stili kullanıyor."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ProgressBar" />

                        <TextBlock
                            Margin="0,8,0,3"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Varsayılan · Success · Info · Warning · Danger" />
                        <ProgressBar Value="70" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarSuccess}"
                            Value="100" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarInfo}"
                            Value="55" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarWarning}"
                            Value="40" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarDanger}"
                            Value="22" />

                        <TextBlock
                            Margin="0,12,0,3"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Şeritli (hareketli)" />
                        <ProgressBar Style="{StaticResource ProgressBarPrimaryStripe}" Value="70" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarSuccessStripe}"
                            Value="55" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarWarningStripe}"
                            Value="40" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            Style="{StaticResource ProgressBarDangerStripe}"
                            Value="25" />

                        <TextBlock
                            Margin="0,12,0,3"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Düz (flat) · belirsiz" />
                        <ProgressBar Style="{StaticResource ProgressBarFlat}" Value="60" />
                        <ProgressBar
                            Margin="0,5,0,0"
                            IsIndeterminate="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" MinWidth="150">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ProgressRing" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:ProgressRing Value="25" />
                            <ui:ProgressRing
                                Margin="10,0,0,0"
                                Style="{StaticResource ProgressRingSuccess}"
                                Value="60" />
                            <ui:ProgressRing
                                Margin="10,0,0,0"
                                Style="{StaticResource ProgressRingWarning}"
                                Value="85" />
                            <ui:ProgressRing
                                Margin="10,0,0,0"
                                Style="{StaticResource ProgressRingDanger}"
                                Value="100" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,12,0,3"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Belirsiz · büyük" />
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing IsIndeterminate="True" />
                            <ui:ProgressRing
                                Margin="12,0,0,0"
                                IsIndeterminate="True"
                                RingSize="36"
                                Style="{StaticResource ProgressRingInfo}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="TypingText" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="ShadeUI bir " />
                        <ui:TypingText
                            DeleteSpeed="35"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Loop="True"
                            PauseDelay="1400"
                            TextStyle="Subtitle"
                            TypeSpeed="65">
                            <ui:TypingText.Words>
                                <sys:String>tema kütüphanesi</sys:String>
                                <sys:String>kontrol seti</sys:String>
                                <sys:String>pencere çerçevesi</sys:String>
                                <sys:String>tasarım sistemi</sys:String>
                            </ui:TypingText.Words>
                        </ui:TypingText>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="130"
                            Margin="0,0,10,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CursorStyle=Line" />
                        <ui:TypingText
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            CursorStyle="Line"
                            Duration="70"
                            Loop="True"
                            Text="dosya adı yazılıyor" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="130"
                            Margin="0,0,10,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CursorStyle=Block" />
                        <ui:TypingText
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            CursorStyle="Block"
                            Duration="70"
                            Loop="True"
                            Text="terminal modu" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Width="130"
                            Margin="0,0,10,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CursorStyle=Underscore" />
                        <ui:TypingText
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            CursorStyle="Underscore"
                            Duration="70"
                            Loop="True"
                            Text="eski okul" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Width="130"
                            Margin="0,0,10,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="ShowCursor=False" />
                        <ui:TypingText
                            Grid.Row="3"
                            Grid.Column="1"
                            Delay="400"
                            Duration="70"
                            ShowCursor="False"
                            Text="imleçsiz, tek sefer yazılır" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

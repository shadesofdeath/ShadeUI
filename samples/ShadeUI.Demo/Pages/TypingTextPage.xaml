<UserControl
    x:Class="ShadeUI.Demo.Pages.TypingTextPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.shadeui.dev/2026/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="TypingText" />
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Kendini harf harf yazan metin. Tek bir metni ya da sırayla yazılıp silinen bir kelime dizisini canlandırır; varsayılan olarak görünüm alanına girince başlar." />

            <ui:ControlExample x:Name="Ex1" Description="Words dolduğunda Text yok sayılır; Loop ile döngüye girer." Header="Kelime dizisi">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="ShadeUI bir " />
                    <ui:TypingText
                        DeleteSpeed="35"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Loop="True"
                        PauseDelay="1400"
                        TextStyle="Subtitle"
                        TypeSpeed="65">
                        <ui:TypingText.Words>
                            <sys:String>tema kütüphanesi</sys:String>
                            <sys:String>kontrol seti</sys:String>
                            <sys:String>tasarım sistemi</sys:String>
                        </ui:TypingText.Words>
                    </ui:TypingText>
                </StackPanel>
            </ui:ControlExample>

            <ui:ControlExample x:Name="Ex2" Description="VS Code'daki gibi üç imleç biçimi; BlinkCursor ile yanıp sönme kapatılabilir." Header="İmleç biçimleri">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="130"
                        Margin="0,0,10,4"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="CursorStyle=Line" />
                    <ui:TypingText
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        CursorStyle="Line"
                        Duration="70"
                        Loop="True"
                        Text="dosya adı yazılıyor" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="130"
                        Margin="0,0,10,4"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="CursorStyle=Block" />
                    <ui:TypingText
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        CursorStyle="Block"
                        Duration="70"
                        Loop="True"
                        Text="terminal modu" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="130"
                        Margin="0,0,10,4"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="CursorStyle=Underscore" />
                    <ui:TypingText
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        CursorStyle="Underscore"
                        Duration="70"
                        Loop="True"
                        Text="eski okul" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Width="130"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="ShowCursor=False" />
                    <ui:TypingText
                        Grid.Row="3"
                        Grid.Column="1"
                        Delay="400"
                        Duration="70"
                        ShowCursor="False"
                        Text="imleçsiz, tek sefer yazılır" />
                </Grid>
            </ui:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>

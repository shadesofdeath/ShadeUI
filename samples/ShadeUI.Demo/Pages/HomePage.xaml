<UserControl
    x:Class="ShadeUI.Demo.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ShadeUI'ye hoş geldin" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Modern, Fluent tasarım dilinden ilham alan WPF tema kütüphanesi. Bu pencere ShadeWindow, üstteki başlık çubuğu TitleBar, soldaki menü ise ShadeUI navigasyon stiliyle çiziliyor." />

            <Border Margin="0,16,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Butonlar" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Varsayılan Buton" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Vurgulu Buton"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Devre Dışı"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tipografi" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Title — 20" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Subtitle — 16" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Body Strong — 12" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Body — 12" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Caption — 11" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sistem teması" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Bu uygulama Windows'un koyu/açık temasını ve vurgu rengini canlı takip ediyor. Windows ayarlarından temayı değiştirip dene." />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

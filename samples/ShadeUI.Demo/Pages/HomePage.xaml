<UserControl
    x:Class="ShadeUI.Demo.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.shadeui.dev/2026/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ShadeUI'ye hoş geldin" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Modern, Fluent tasarım dilinden ilham alan WPF tema kütüphanesi. Bu pencere ShadeWindow, üstteki başlık çubuğu TitleBar, soldaki menü ise ShadeUI navigasyon stiliyle çiziliyor." />

            <Border Margin="0,16,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="TypingText" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="ShadeUI bir " />
                        <ui:TypingText
                            DeleteSpeed="35"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Loop="True"
                            PauseDelay="1400"
                            TextStyle="Subtitle"
                            TypeSpeed="65">
                            <ui:TypingText.Words>
                                <sys:String>tema kütüphanesi</sys:String>
                                <sys:String>kontrol seti</sys:String>
                                <sys:String>pencere çerçevesi</sys:String>
                                <sys:String>tasarım sistemi</sys:String>
                            </ui:TypingText.Words>
                        </ui:TypingText>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="120"
                            Margin="0,0,10,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CursorStyle=Line" />
                        <ui:TypingText
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            CursorStyle="Line"
                            Duration="70"
                            Loop="True"
                            Text="dosya adı yazılıyor" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="120"
                            Margin="0,0,10,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CursorStyle=Block" />
                        <ui:TypingText
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            CursorStyle="Block"
                            Duration="70"
                            Loop="True"
                            Text="terminal modu" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Width="120"
                            Margin="0,0,10,4"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CursorStyle=Underscore" />
                        <ui:TypingText
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            CursorStyle="Underscore"
                            Duration="70"
                            Loop="True"
                            Text="eski okul" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Width="120"
                            Margin="0,0,10,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="ShowCursor=False" />
                        <ui:TypingText
                            Grid.Row="3"
                            Grid.Column="1"
                            Delay="400"
                            Duration="70"
                            ShowCursor="False"
                            Text="imleçsiz, tek sefer yazılır" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Butonlar" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Content="Varsayılan Buton" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Vurgulu Buton"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="Devre Dışı"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Tipografi" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Title — 20" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Subtitle — 16" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Body Strong — 12" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Body — 12" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Caption — 11" />
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sistem teması" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Bu uygulama Windows'un koyu/açık temasını ve vurgu rengini canlı takip ediyor. Windows ayarlarından temayı değiştirip dene." />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="ShadeUI.Demo.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="820"
            Margin="24,18,24,24"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="ShadeUI'ye hoş geldin" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Fluent tasarım dilinden ilham alan, .NET 10 / WPF için modern bir tema ve kontrol kütüphanesi. Bu pencerenin kendisi ShadeWindow, üstteki başlık çubuğu TitleBar, soldaki menü ise NavigationView." />

            <Border Margin="0,16,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Neler hazır" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Pencere ve kabuk" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="ShadeWindow · TitleBar (Snap Layouts, sistem menüsü) · NavigationView · TransitionPresenter"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,12,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Kontroller" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Button · TextBox · CheckBox · RadioButton · ToggleSwitch · ComboBox · TypingText · ContextMenu · ToolTip"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Tema" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Windows koyu/açık temasını ve vurgu rengini canlı takip eder; WinUI adlandırmasıyla token tabanlı palet"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,12,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Yoğunluk" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="24 px kontrol yüksekliği, 12 px gövde yazısı; tüm ölçüler tek dosyadaki token'lardan gelir"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource ShadeCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Hızlı başlangıç" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="App.xaml içine iki sözlüğü eklemen yeterli:" />
                    <Border
                        Margin="0,8,0,0"
                        Padding="10,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas, Courier New"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="&lt;ResourceDictionary.MergedDictionaries&gt;" /><LineBreak />
                            <Run Text="    &lt;ui:ThemesDictionary Theme=&quot;System&quot; /&gt;" /><LineBreak />
                            <Run Text="    &lt;ui:ControlsDictionary /&gt;" /><LineBreak />
                            <Run Text="&lt;/ResourceDictionary.MergedDictionaries&gt;" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

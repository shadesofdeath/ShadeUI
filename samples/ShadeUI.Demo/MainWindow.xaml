<ui:ShadeWindow
    x:Class="ShadeUI.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.shadeui.dev/2026/xaml"
    Title="ShadeUI Demo"
    Width="1040"
    Height="660"
    MinWidth="680"
    MinHeight="440"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ShadeUI Demo" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox
                x:Name="Nav"
                Grid.Column="0"
                Margin="4,2,4,6"
                SelectedIndex="0"
                SelectionChanged="OnNavSelectionChanged"
                Style="{StaticResource ShadeNavigationStyle}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="{DynamicResource NavigationIconSize}"
                            Text="&#xE80F;" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Giriş" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="{DynamicResource NavigationIconSize}"
                            Text="&#xE8A9;" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Kontroller" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="{DynamicResource NavigationIconSize}"
                            Text="&#xE790;" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Tema" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="{DynamicResource NavigationIconSize}"
                            Text="&#xE713;" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="Ayarlar" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <Border
                Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="4,0,0,0">
                <ContentControl x:Name="PageHost" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</ui:ShadeWindow>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Accent colors (static defaults, replaced at runtime by AccentManager)  -->
    <Color x:Key="SystemAccentColor">#FF0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#FF3393DD</Color>
    <Color x:Key="SystemAccentColorLight2">#FF66AEE5</Color>
    <Color x:Key="SystemAccentColorLight3">#FF99C9EE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF0060AA</Color>
    <Color x:Key="SystemAccentColorDark2">#FF00487F</Color>
    <Color x:Key="SystemAccentColorDark3">#FF003055</Color>

    <!--  Surfaces — three distinct layers: window shell / content pane / card  -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14000000" />

    <!--  Non-client 1 px window border (applied through DWM)  -->
    <Color x:Key="WindowBorderColor">#FFCDCDCD</Color>

    <!--  Raw stroke colors (needed as Color for the gradient tokens below)  -->
    <Color x:Key="ControlStrokeColorDefault">#0F000000</Color>
    <Color x:Key="ControlStrokeColorSecondary">#29000000</Color>

    <!--  Control fills  -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource ControlStrokeColorSecondary}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#72000000" />

    <!--  Recessed fills and strong strokes (CheckBox / RadioButton boxes)  -->
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#06000000" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#9C000000" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#37000000" />

    <!--  ToggleSwitch  -->
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#FFB6B6B6" />
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFFFF" />

    <!--  Flyout / popup surfaces (bir basamak yukarıda, gölgeyle yükseltilir)  -->
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#1F000000" />
    <Color x:Key="FlyoutShadowColor">#FF000000</Color>

    <!--  Reveal highlight (dark on light surfaces)  -->
    <Color x:Key="RevealFillColorNear">#14000000</Color>
    <Color x:Key="RevealFillColorMid">#06000000</Color>
    <Color x:Key="RevealStrokeColorNear">#59000000</Color>
    <Color x:Key="RevealStrokeColorMid">#1F000000</Color>
    <Color x:Key="RevealColorTransparent">#00000000</Color>

    <!--  Elevation border: same 1px ring as ControlStrokeColorDefault, but a stronger bottom edge  -->
    <LinearGradientBrush
        x:Key="ControlElevationBorderBrush"
        MappingMode="Absolute"
        StartPoint="0,0"
        EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleY="-1" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="{StaticResource ControlStrokeColorSecondary}" />
        <GradientStop Offset="1.0" Color="{StaticResource ControlStrokeColorDefault}" />
    </LinearGradientBrush>

    <!--  Subtle fills (hover / pressed on transparent surfaces)  -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />

    <!--  Strokes and dividers  -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3FFFFFF" />

    <!--  Accent brushes (static defaults, replaced at runtime by AccentManager)  -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0060AA" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60060AA" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0060AA" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#37000000" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF00487F" />

</ResourceDictionary>

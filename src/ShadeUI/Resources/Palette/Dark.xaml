<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Accent colors (static defaults, replaced at runtime by AccentManager)  -->
    <Color x:Key="SystemAccentColor">#FF0078D4</Color>
    <Color x:Key="SystemAccentColorLight1">#FF3393DD</Color>
    <Color x:Key="SystemAccentColorLight2">#FF66AEE5</Color>
    <Color x:Key="SystemAccentColorLight3">#FF99C9EE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF0060AA</Color>
    <Color x:Key="SystemAccentColorDark2">#FF00487F</Color>
    <Color x:Key="SystemAccentColorDark3">#FF003055</Color>

    <!--  Surfaces  -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />

    <!--  Control fills  -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#8BFFFFFF" />

    <!--  Subtle fills (hover / pressed on transparent surfaces)  -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF000000" />

    <!--  Strokes and dividers  -->
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3000000" />

    <!--  Accent brushes (static defaults, replaced at runtime by AccentManager)  -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF66AEE5" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E666AEE5" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC66AEE5" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF99C9EE" />

</ResourceDictionary>

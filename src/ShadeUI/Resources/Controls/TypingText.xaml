<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ShadeUI.Controls">

    <Style TargetType="{x:Type controls:TypingText}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TypingText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="PART_Text"
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontStretch="{TemplateBinding FontStretch}"
                            FontStyle="{TemplateBinding FontStyle}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding DisplayText}"
                            TextWrapping="{TemplateBinding TextWrapping}" />

                        <Grid
                            x:Name="CursorHost"
                            Width="{TemplateBinding CursorWidth}"
                            Height="{TemplateBinding CursorHeight}"
                            Margin="1,0,0,0"
                            VerticalAlignment="Center">

                            <Rectangle
                                x:Name="CursorLine"
                                Width="{TemplateBinding CursorThickness}"
                                HorizontalAlignment="Left"
                                Fill="{TemplateBinding CursorBrush}" />

                            <Rectangle
                                x:Name="CursorBlock"
                                Fill="{TemplateBinding CursorBrush}"
                                Visibility="Collapsed" />

                            <Rectangle
                                x:Name="CursorUnderscore"
                                Height="{TemplateBinding CursorThickness}"
                                VerticalAlignment="Bottom"
                                Fill="{TemplateBinding Foreground}"
                                Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <Trigger Property="CursorStyle" Value="Block">
                            <Setter TargetName="CursorLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CursorBlock" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CursorStyle" Value="Underscore">
                            <Setter TargetName="CursorLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CursorUnderscore" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowCursor" Value="False">
                            <Setter TargetName="CursorHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  VS Code kadans: 530 ms açık / 530 ms kapalı, sert geçiş  -->
                        <Trigger Property="BlinkCursor" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CursorHost" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.53" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.06" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--  "as" prop karşılığı: anlamsal seviye tipografiyle ifade ediliyor  -->
                        <Trigger Property="TextStyle" Value="Caption">
                            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
                        </Trigger>
                        <Trigger Property="TextStyle" Value="BodyStrong">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="TextStyle" Value="Subtitle">
                            <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
                            <Setter Property="FontSize" Value="{DynamicResource SubtitleFontSize}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="TextStyle" Value="Title">
                            <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
                            <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="TextStyle" Value="TitleLarge">
                            <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
                            <Setter Property="FontSize" Value="{DynamicResource TitleLargeFontSize}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="TextStyle" Value="Display">
                            <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
                            <Setter Property="FontSize" Value="{DynamicResource DisplayFontSize}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <!--  CursorBrush verilirse Foreground yerine o kullanılır  -->
                        <Trigger Property="CursorBrush" Value="{x:Null}">
                            <Setter TargetName="CursorLine" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="CursorBlock" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="CursorUnderscore" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="ShadeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ShadeFontFamilyDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="ShadeIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!--  Compact type ramp — Windows 11 rampasının bir tık sıkıştırılmış hâli  -->
    <sys:Double x:Key="CaptionFontSize">11</sys:Double>
    <sys:Double x:Key="BodyFontSize">12</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">16</sys:Double>
    <sys:Double x:Key="TitleFontSize">20</sys:Double>
    <sys:Double x:Key="TitleLargeFontSize">28</sys:Double>
    <sys:Double x:Key="DisplayFontSize">40</sys:Double>

    <Style x:Key="CaptionTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
    </Style>

    <Style x:Key="BodyTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyStrongTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource SubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TitleTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TitleLargeTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource TitleLargeFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DisplayTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource DisplayFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>

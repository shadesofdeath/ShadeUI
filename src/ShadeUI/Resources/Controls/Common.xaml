<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ShadeUI ölçü token'ları — "compact" yoğunluk.
        Bütün kontroller ölçülerini buradan alır; tek dosyadan yoğunluk değiştirilebilir.
    -->

    <!--  Şekil  -->
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusBottom">0,0,2,2</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>

    <!--  Kontrol ölçüleri  -->
    <sys:Double x:Key="ControlHeight">24</sys:Double>
    <sys:Double x:Key="ControlMinWidth">60</sys:Double>
    <sys:Double x:Key="ControlFontSize">12</sys:Double>
    <sys:Double x:Key="ControlIconSize">12</sys:Double>
    <sys:Double x:Key="InlineButtonSize">16</sys:Double>
    <sys:Double x:Key="InlineButtonGlyphSize">9</sys:Double>

    <sys:Double x:Key="CheckBoxSize">16</sys:Double>
    <sys:Double x:Key="CheckGlyphSize">11</sys:Double>
    <CornerRadius x:Key="CircleCornerRadius">8</CornerRadius>

    <!--
        ToggleSwitch — kaynak CSS em tabanlı olduğu için ölçüler ControlFontSize (12) ile çarpıldı:
        3.5em x 2em iz, 1.4em kol, 0.3em iç boşluk, 1.5em yol, 10/17em ve 8/17em yarıçaplar.
        Yol (travel) = Width - 2*Inset - KnobSize; storyboard'da literal olarak da geçer.
    -->
    <sys:Double x:Key="ToggleSwitchWidth">32</sys:Double>
    <sys:Double x:Key="ToggleSwitchHeight">18</sys:Double>
    <sys:Double x:Key="ToggleSwitchKnobSize">13</sys:Double>
    <sys:Double x:Key="ToggleSwitchTravel">14</sys:Double>
    <Thickness x:Key="ToggleSwitchKnobInset">2.5,0,0,0</Thickness>
    <CornerRadius x:Key="ToggleSwitchTrackRadius">5</CornerRadius>
    <CornerRadius x:Key="ToggleSwitchKnobRadius">4</CornerRadius>

    <Thickness x:Key="ControlPadding">8,3,8,3</Thickness>
    <Thickness x:Key="ButtonPadding">10,3,10,3</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>

    <!--  Pencere çerçevesi  -->
    <sys:Double x:Key="TitleBarHeight">36</sys:Double>
    <sys:Double x:Key="TitleBarButtonWidth">40</sys:Double>
    <sys:Double x:Key="TitleBarGlyphSize">9</sys:Double>

    <!--  Navigasyon  -->
    <sys:Double x:Key="NavigationItemHeight">30</sys:Double>
    <sys:Double x:Key="NavigationIconSize">14</sys:Double>

    <!--  Kaydırma çubuğu  -->
    <sys:Double x:Key="ScrollBarSize">10</sys:Double>

    <!--  İlerleme  -->
    <CornerRadius x:Key="ProgressBarCornerRadius">4</CornerRadius>
    <sys:Double x:Key="ProgressRingSize">20</sys:Double>

</ResourceDictionary>

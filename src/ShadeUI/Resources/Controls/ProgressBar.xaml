<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================  PROGRESSBAR  ================

        ProgressBarBaseStyle doğrudan kullanılmak için değildir; diğer stiller ona
        BasedOn ile bağlanır. Renk varyantları yalnızca Foreground'u değiştirir.

        Belirsiz (IsIndeterminate) durumda genişliği bilmeye gerek kalmasın diye
        gösterge tam genişlikte tutulup ScaleX ile %35'e indiriliyor, sonra
        RenderTransformOrigin soldan sağa animasyonlanıyor: ölçek sabit kalırken
        parça izin üzerinde kayıyor.
    -->

    <Style x:Key="ProgressBarBaseStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border
                            x:Name="Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ProgressBarCornerRadius}" />

                        <!--  belirli ilerleme: PART_Indicator'ın genişliğini WPF ayarlar  -->
                        <Border
                            x:Name="PART_Track"
                            Background="Transparent" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{DynamicResource ProgressBarCornerRadius}">
                            <Border
                                x:Name="Stripes"
                                CornerRadius="{DynamicResource ProgressBarCornerRadius}"
                                Opacity="0"
                                Visibility="Collapsed">
                                <Border.Background>
                                    <DrawingBrush
                                        Stretch="None"
                                        TileMode="Tile"
                                        Viewport="0,0,12,12"
                                        ViewportUnits="Absolute">
                                        <DrawingBrush.Transform>
                                            <TranslateTransform x:Name="StripeShift" X="0" />
                                        </DrawingBrush.Transform>
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FFFFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <!--  12x12 karoda kesintisiz 45 derece şerit  -->
                                                    <PathGeometry Figures="M0,0 L6,0 L0,6 Z M12,0 L12,6 L6,12 L0,12 Z" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!--  belirsiz ilerleme  -->
                        <Border
                            x:Name="IndeterminatePill"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{DynamicResource ProgressBarCornerRadius}"
                            RenderTransformOrigin="0,0.5"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.35" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminatePill" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <PointAnimation
                                            Storyboard.TargetName="IndeterminatePill"
                                            Storyboard.TargetProperty="RenderTransformOrigin"
                                            From="0,0.5"
                                            To="1,0.5"
                                            Duration="0:0:1.4">
                                            <PointAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </PointAnimation.EasingFunction>
                                        </PointAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="IndeterminatePill" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ProgressBarBaseStyle}" TargetType="{x:Type ProgressBar}" />

    <!--  Renk varyantları  -->

    <Style
        x:Key="ProgressBarSuccess"
        BasedOn="{StaticResource ProgressBarBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarInfo"
        BasedOn="{StaticResource ProgressBarBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarWarning"
        BasedOn="{StaticResource ProgressBarBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarDanger"
        BasedOn="{StaticResource ProgressBarBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!--  Şeritli varyantlar: taban stil şeritleri görünür kılıp kaydırmayı başlatır  -->

    <Style
        x:Key="ProgressBarStripeBaseStyle"
        BasedOn="{StaticResource ProgressBarBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8" />
        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="False">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ProgressBarCornerRadius}" />
                                <Border x:Name="PART_Track" Background="Transparent" />
                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    ClipToBounds="True"
                                    CornerRadius="{DynamicResource ProgressBarCornerRadius}">
                                    <Border CornerRadius="{DynamicResource ProgressBarCornerRadius}" Opacity="0.28">
                                        <Border.Background>
                                            <DrawingBrush
                                                Stretch="None"
                                                TileMode="Tile"
                                                Viewport="0,0,12,12"
                                                ViewportUnits="Absolute">
                                                <DrawingBrush.Transform>
                                                    <TranslateTransform x:Name="StripeShift" X="0" />
                                                </DrawingBrush.Transform>
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="#FFFFFFFF">
                                                        <GeometryDrawing.Geometry>
                                                            <PathGeometry Figures="M0,0 L6,0 L0,6 Z M12,0 L12,6 L6,12 L0,12 Z" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="StripeShift"
                                                Storyboard.TargetProperty="X"
                                                From="0"
                                                To="12"
                                                Duration="0:0:0.7" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ProgressBarPrimaryStripe"
        BasedOn="{StaticResource ProgressBarStripeBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarSuccessStripe"
        BasedOn="{StaticResource ProgressBarStripeBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarInfoStripe"
        BasedOn="{StaticResource ProgressBarStripeBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarWarningStripe"
        BasedOn="{StaticResource ProgressBarStripeBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <Style
        x:Key="ProgressBarDangerStripe"
        BasedOn="{StaticResource ProgressBarStripeBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!--  Düz (flat): köşe yuvarlaması yok, daha kalın iz  -->
    <Style
        x:Key="ProgressBarFlat"
        BasedOn="{StaticResource ProgressBarBaseStyle}"
        TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}" />
                        <Border
                            x:Name="IndeterminatePill"
                            Background="{TemplateBinding Foreground}"
                            RenderTransformOrigin="0,0.5"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.35" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminatePill" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <PointAnimation
                                            Storyboard.TargetName="IndeterminatePill"
                                            Storyboard.TargetProperty="RenderTransformOrigin"
                                            From="0,0.5"
                                            To="1,0.5"
                                            Duration="0:0:1.4">
                                            <PointAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </PointAnimation.EasingFunction>
                                        </PointAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ShadeUI.Controls">

    <Style TargetType="{x:Type controls:TitleBarButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TitleBarButton}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <TextBlock
                            x:Name="GlyphText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="10"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Glyph}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ButtonType" Value="Close" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="#FFC42B1C" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="#FFFFFFFF" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ButtonType" Value="Close" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="#E6C42B1C" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="#B3FFFFFF" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ButtonType" Value="Minimize">
                <Setter Property="Glyph" Value="&#xE921;" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Maximize">
                <Setter Property="Glyph" Value="&#xE922;" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Restore">
                <Setter Property="Glyph" Value="&#xE923;" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Close">
                <Setter Property="Glyph" Value="&#xE8BB;" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:TitleBar}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TitleBar}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="IconImage"
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{TemplateBinding Icon}" />

                        <TextBlock
                            x:Name="TitleText"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Title}"
                            TextTrimming="CharacterEllipsis" />

                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding TrailingContent}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal">
                            <controls:TitleBarButton x:Name="PART_MinimizeButton" ButtonType="Minimize" />
                            <controls:TitleBarButton x:Name="PART_MaximizeButton" ButtonType="Maximize" />
                            <controls:TitleBarButton x:Name="PART_CloseButton" ButtonType="Close" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleText" Property="Margin" Value="16,0,0,0" />
                        </Trigger>
                        <Trigger Property="ShowMinimize" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMaximize" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowClose" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                            <Setter TargetName="PART_MaximizeButton" Property="ButtonType" Value="Restore" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ShadeUI.Controls">

    <Style TargetType="{x:Type controls:TitleBarButton}">
        <Setter Property="Width" Value="{DynamicResource TitleBarButtonWidth}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TitleBarButton}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <TextBlock
                            x:Name="GlyphText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="{DynamicResource TitleBarGlyphSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Glyph}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>

                        <!--  Windows owns the pointer during Snap Layouts, so hover/press are driven by TitleBar  -->
                        <Trigger Property="IsSimulatedHover" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSimulatedPress" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ButtonType" Value="Close" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="#FFC42B1C" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="#FFFFFFFF" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ButtonType" Value="Close" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="#E6C42B1C" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="#B3FFFFFF" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ButtonType" Value="Minimize">
                <Setter Property="Glyph" Value="&#xE921;" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Maximize">
                <Setter Property="Glyph" Value="&#xE922;" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Restore">
                <Setter Property="Glyph" Value="&#xE923;" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Close">
                <Setter Property="Glyph" Value="&#xE8BB;" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:TitleBar}">
        <Setter Property="Height" Value="{DynamicResource TitleBarHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TitleFontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TitleBar}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Title first so the caption buttons stay on top when it is centred  -->
                        <TextBlock
                            x:Name="TitleText"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding TitleFontSize}"
                            FontWeight="{TemplateBinding TitleFontWeight}"
                            Foreground="{TemplateBinding TitleForeground}"
                            IsHitTestVisible="False"
                            Text="{TemplateBinding Title}"
                            TextTrimming="CharacterEllipsis" />

                        <Image
                            x:Name="IconImage"
                            Grid.Column="0"
                            Width="14"
                            Height="14"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{TemplateBinding Icon}"
                            Visibility="Collapsed" />

                        <TextBlock
                            x:Name="IconGlyphText"
                            Grid.Column="0"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource ShadeIconFontFamily}"
                            FontSize="{DynamicResource NavigationIconSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding IconGlyph}"
                            Visibility="Collapsed" />

                        <ContentPresenter
                            x:Name="LeadingHost"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding LeadingContent}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                        <ContentPresenter
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding TrailingContent}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />

                        <StackPanel
                            Grid.Column="4"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal">
                            <controls:TitleBarButton x:Name="PART_MinimizeButton" ButtonType="Minimize" />
                            <controls:TitleBarButton
                                x:Name="PART_MaximizeButton"
                                ButtonType="Maximize"
                                IsEnabled="{TemplateBinding CanMaximize}" />
                            <controls:TitleBarButton x:Name="PART_CloseButton" ButtonType="Close" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <!--  Icon  -->
                        <Trigger Property="IconMode" Value="Image">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IconMode" Value="Glyph">
                            <Setter TargetName="IconGlyphText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IconMode" Value="None">
                            <Setter TargetName="TitleText" Property="Margin" Value="12,0,0,0" />
                        </Trigger>

                        <!--  Leading slot only takes space when it has content  -->
                        <Trigger Property="LeadingContent" Value="{x:Null}">
                            <Setter TargetName="LeadingHost" Property="Margin" Value="0" />
                        </Trigger>

                        <!--  Title alignment  -->
                        <Trigger Property="TitleAlignment" Value="Center">
                            <Setter TargetName="TitleText" Property="Grid.Column" Value="0" />
                            <Setter TargetName="TitleText" Property="Grid.ColumnSpan" Value="5" />
                            <Setter TargetName="TitleText" Property="Margin" Value="0" />
                            <Setter TargetName="TitleText" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                        <Trigger Property="TitleAlignment" Value="Right">
                            <Setter TargetName="TitleText" Property="Margin" Value="10,0,10,0" />
                            <Setter TargetName="TitleText" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>

                        <!--  Title colour override  -->
                        <Trigger Property="TitleForeground" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <!--  Caption buttons  -->
                        <Trigger Property="ShowMinimize" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMaximize" Value="False">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowClose" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                            <Setter TargetName="PART_MaximizeButton" Property="ButtonType" Value="Restore" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

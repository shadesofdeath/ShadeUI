<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ShadeUI.Controls">

    <Style x:Key="ControlExampleIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter
                            x:Name="Host"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ControlExample}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ControlExample}">
                    <StackPanel>
                        <TextBlock
                            x:Name="HeaderText"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Style="{DynamicResource BodyStrongTextBlockStyle}"
                            Text="{TemplateBinding Header}" />

                        <TextBlock
                            x:Name="DescriptionText"
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Style="{DynamicResource CaptionTextBlockStyle}"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,8,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}">
                            <StackPanel>
                                <!--  canlı önizleme  -->
                                <ContentPresenter
                                    Margin="14"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                <!--  kod paneli  -->
                                <Border x:Name="CodeSection" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <Grid Margin="8,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                x:Name="PART_ToggleCodeButton"
                                                Grid.Column="0"
                                                AutomationProperties.Name="XAML"
                                                Style="{StaticResource ControlExampleIconButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="ToggleGlyph"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{DynamicResource ShadeIconFontFamily}"
                                                        FontSize="8"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Text="&#xE70D;">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform x:Name="ToggleGlyphRotate" Angle="0" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="XAML" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                x:Name="PART_CopyButton"
                                                Grid.Column="2"
                                                AutomationProperties.Name="Kopyala"
                                                Style="{StaticResource ControlExampleIconButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="CopyGlyph"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{DynamicResource ShadeIconFontFamily}"
                                                        FontSize="10"
                                                        Text="&#xE8C8;" />
                                                    <TextBlock
                                                        x:Name="CopyLabel"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="Kopyala" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Border
                                            x:Name="CodeBox"
                                            Padding="12,10"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="Collapsed">
                                            <ScrollViewer
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Disabled">
                                                <TextBox
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="Cascadia Mono, Consolas, Courier New"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    IsReadOnly="True"
                                                    Padding="0"
                                                    Text="{TemplateBinding DisplayXaml}" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Xaml" Value="{x:Null}">
                            <Setter TargetName="CodeSection" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsCodeVisible" Value="True">
                            <Setter TargetName="CodeBox" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ToggleGlyphRotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="180"
                                            Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ToggleGlyphRotate"
                                            Storyboard.TargetProperty="Angle"
                                            To="0"
                                            Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsCopied" Value="True">
                            <Setter TargetName="CopyGlyph" Property="Text" Value="&#xE73E;" />
                            <Setter TargetName="CopyGlyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="CopyLabel" Property="Text" Value="Kopyalandı" />
                            <Setter TargetName="CopyLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Style x:Key="DefaultToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ShadeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border
                        x:Name="Root"
                        Margin="8,4,8,10"
                        Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource FlyoutBackgroundBrush}"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="TipSlide" Y="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Direction="270"
                                Opacity="0.35"
                                ShadowDepth="2"
                                Color="{DynamicResource FlyoutShadowColor}" />
                        </Border.Effect>
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <!--  düz metin ipuçları MaxWidth'e göre sarsın  -->
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ToolTip.Opened">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="Root"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.12" />
                                    <DoubleAnimation
                                        Storyboard.TargetName="TipSlide"
                                        Storyboard.TargetProperty="Y"
                                        From="-4"
                                        To="0"
                                        Duration="0:0:0.20">
                                        <DoubleAnimation.EasingFunction>
                                            <QuarticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultToolTipStyle}" TargetType="{x:Type ToolTip}" />

</ResourceDictionary>
